# Скопируйте в .env: cp .env.example .env  (docker compose читает .env автоматически)

# Модель Ollama, уже скачанная на хосте (ollama list). Обязательно.
LLM_MODEL=gemma4:e2b

# Индекс, который отдаёт сервис chroma: Task3/chroma_db (основной) или Task5/chroma_db («злонамеренный» файл).
# Значение из командной строки (DB_DIR=... docker compose ...) главнее значения из этого файла.
DB_DIR=Task3/chroma_db

# Адрес Ollama. Для бота в Docker: http://host.docker.internal:11434 (Ollama на хосте).
# Для запуска без Docker: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
